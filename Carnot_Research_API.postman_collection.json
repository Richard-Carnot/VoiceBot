              "mode": "raw",
              "raw": "{\n  \"text\": \"नमस्ते, कार्नोट रीसर्चे एआई प्लेटफॉर्म में आपका स्वागत है।\",\n  \"model\": \"CR_voice1\",\n  \"target_language\": \"hi-IN\",\n  \"voice\": \"default\",\n  \"pace\": 1.0,\n  \"sample_rate\": 44100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/tts/generate",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tts", "generate"]
